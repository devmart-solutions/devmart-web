# Email de contacto (pendiente de confirmar, p. ej. hola@devmart.com.co).
NEXT_PUBLIC_EMAIL=

# URL pública del sitio (dominio pendiente: devmart.com.co, devmart.co…).
NEXT_PUBLIC_SITE_URL=

# Envío de correos: avisos del formulario de contacto y enlaces para recuperar la contraseña del panel.
# Usa Resend si hay RESEND_API_KEY; si no, SMTP (p. ej. el buzón de Hostinger: smtp.hostinger.com, 465).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
FORMSPREE_ENDPOINT=

# Analítica (opcional). Se carga solo la que tenga valor; vacías, no se carga ningún script.
# Google Analytics 4: ID de medición (G-XXXXXXXXXX).
NEXT_PUBLIC_GA_ID=
# Plausible: dominio registrado en Plausible (p. ej. devmart.com.co).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Opcional: URL del script de Plausible (autoalojado o el script propio del sitio).
# Por defecto https://plausible.io/js/script.js
NEXT_PUBLIC_PLAUSIBLE_SRC=

# Base de datos (Neon, desde el Marketplace de Vercel). `vercel env pull .env.local` la trae.
# Sin ella, el sitio usa el contenido estático de src/lib y el panel /admin no funciona.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Panel /admin. No las escribas a mano: `npm run admin:setup -- --email tu@correo.com`
# genera la contraseña, el secreto 2FA y la firma de sesión, y las guarda aquí y en Vercel.
# Después, la contraseña y el 2FA se cambian o recuperan desde el panel (se guardan en la base de datos).
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
SESSION_SECRET=

# Acceso con Google y GitHub (opcional) para el panel y el portal de clientes. Sin ellas no se muestran los botones.
# URL de retorno que hay que registrar: <NEXT_PUBLIC_SITE_URL>/oauth/callback/google y …/oauth/callback/github
# (en GitHub, una app OAuth por dominio: la de producción y otra para localhost si la necesitas).
# En el panel la cuenta social sustituye a la contraseña, pero se sigue pidiendo el código 2FA.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Imágenes del panel (capturas de proyectos y foto del equipo) en Vercel Blob.
# Se crea con el store conectado al proyecto; `vercel env pull .env.local` la trae.
BLOB_READ_WRITE_TOKEN=

# Redes sociales (URL completa del perfil, https://…). Vacías, no se muestran en el pie.
NEXT_PUBLIC_INSTAGRAM=
NEXT_PUBLIC_LINKEDIN=
NEXT_PUBLIC_TIKTOK=
NEXT_PUBLIC_FACEBOOK=
NEXT_PUBLIC_GITHUB=
NEXT_PUBLIC_X=
